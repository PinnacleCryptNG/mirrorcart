# YouCam API (server-side only, never exposed to the browser)
YOUCAM_API_KEY=
# true = fake YouCam client with documented response shapes + placeholder images
YOUCAM_MOCK=true
# true = force demo mode (pre-generated looks for sample models)
DEMO_MODE=false
# Live units allowed per UTC day before falling back to demo mode
DAILY_UNIT_CAP=60
# Password for /dashboard and /admin
DASHBOARD_PASS=
# Secret for the hourly retention cron (Vercel sends it as Bearer token)
CRON_SECRET=
# Public base URL (used for ref_file_url of catalogue images and the embed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Blob (auto-set when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=
# Upstash Redis / Vercel KV (auto-set by the integration; either pair works)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
